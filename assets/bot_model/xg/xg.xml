<mujoco model="DOG">
  <compiler angle="radian" meshdir="./meshes"/>
  
  <!-- xg.xml: based on v2 with added system damping -->
  <!--
    Strategy change: stabilize the robot by adding system damping instead of using soft contacts.

    Key modifications:
    1. Keep the original contact parameters (do not soften them)
    2. Increase impratio (impedance ratio) to stabilize constraint solving
    3. Increase joint damping to reduce high-frequency oscillations
    4. Reduce integrator sensitivity
  -->

  <!-- Visual configuration: enlarge the offscreen framebuffer to support high-resolution rendering -->
  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <!-- ========== Key: add system damping ========== -->
  <option timestep="0.002" iterations="10" ls_iterations="10" solver="Newton" integrator="Euler"
          impratio="10">
    <!-- impratio: impedance ratio, default 1; higher values stabilize constraint solving -->
    <!-- larger values make contact response smoother, but may reduce accuracy -->
    <flag contact="enable" constraint="enable"/>
  </option>

  <!-- Keep the original contact parameters; do not soften them -->
  <default>
    <geom condim="3" friction="0.8 0.005 0.0001" solref="0.035 1.1" solimp="0.9 0.92 0.015"/>

    <!-- ========== Key modification: add joint damping ========== -->
    <!-- This reduces high-frequency oscillations, producing smoother motion -->
    <joint damping="0.5" armature="0.01"/>
  </default>

  <asset>
    <!-- Checkered floor texture -->
    <texture name="grid" type="2d" builtin="checker" rgb1="0.3 0.3 0.3" rgb2="0.4 0.4 0.4"
             width="512" height="512" mark="edge" markrgb="0.2 0.2 0.2"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" texuniform="true" 
              reflectance="0.1" shininess="0.1" specular="0.2"/>
    <mesh name="BASE_LINK" file="BASE_LINK.STL"/>
    <mesh name="FBL_ABAD_LINK" file="FL_ABAD_LINK.STL"/>
    <mesh name="FBL_HIP_LINK" file="FL_HIP_LINK.STL"/>
    <mesh name="FBL_KNEE_LINK" file="FL_KNEE_LINK.STL"/>
    <mesh name="FL_FOOT_LINK" file="FL_FOOT_LINK.STL"/>
    <mesh name="FAR_ABAD_LINK" file="FR_ABAD_LINK.STL"/>
    <mesh name="FAR_HIP_LINK" file="FR_HIP_LINK.STL"/>
    <mesh name="FAR_KNEE_LINK" file="FR_KNEE_LINK.STL"/>
    <mesh name="FR_FOOT_LINK" file="FR_FOOT_LINK.STL"/>
    <mesh name="RAR_ABAD_LINK" file="RR_ABAD_LINK.STL"/>
    <mesh name="RAR_HIP_LINK" file="RR_HIP_LINK.STL"/>
    <mesh name="RAR_KNEE_LINK" file="RR_KNEE_LINK.STL"/>
    <mesh name="RR_FOOT_LINK" file="RR_FOOT_LINK.STL"/>
    <mesh name="RBL_ABAD_LINK" file="RL_ABAD_LINK.STL"/>
    <mesh name="RBL_HIP_LINK" file="RL_HIP_LINK.STL"/>
    <mesh name="RBL_KNEE_LINK" file="RL_KNEE_LINK.STL"/>
    <mesh name="RL_FOOT_LINK" file="RL_FOOT_LINK.STL"/>
    <hfield name="terrain" nrow="200" ncol="200" size="10 10 0.7 0.01"/>
  </asset>

  <worldbody>
    <!-- Ground: uses the checkered texture -->
    <geom type="hfield" hfield="terrain" pos="0 0 0" size="10 10" material="grid_mat" 
      contype="1" conaffinity="1" priority="1" friction="1.0 0.005 0.0001" condim="3"/>

    <!-- Ambient light -->
    <light name="ambient" mode="fixed" directional="true"
           diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5" dir="0 0 -1"/>
    <!-- Main light: tracks the robot -->
    <light name="spotlight" mode="targetbodycom" target="torso"
           diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" pos="0 -3 4" cutoff="45"/>
    <!-- Fill light -->
    <light name="fill_light" mode="fixed" directional="true"
           diffuse="0.3 0.3 0.4" specular="0.1 0.1 0.1" pos="3 3 3" dir="-1 -1 -1"/>
    
    <!-- torso: body 1 -->
